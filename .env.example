# Prisma/PostgreSQL connection string
# For local Postgres: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trading_os?schema=public"
# For hosted Postgres (Neon, Supabase, RDS): add ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trading_os?schema=public"

# Canonical public origin for cookie/CSRF checks. Use HTTPS in production.
APP_URL="http://localhost:3000"

# Comma-separated email addresses allowed to manage admin settings.
ADMIN_EMAILS=""

# Optional legacy-site SSO. Set on both servers; use a random secret of 32+ bytes.
# The legacy site signs short-lived HS256 JWT assertions with issuer LEGACY_SSO_ISSUER,
# audience "trading-os", and claims sub, email, email_verified=true, iat, exp (<=120s), jti.
# LEGACY_SSO_ISSUER="xrynex"
# LEGACY_SSO_SECRET=""
# Optional audience(s) also included in old-site assertions; trading-os is always required.
# LEGACY_SSO_AUDIENCES=""

# Public account registration is disabled by default. In production, don't enable it
# until a real email-verification and password-reset delivery flow is configured.
ENABLE_PUBLIC_SIGNUP="false"
EMAIL_VERIFICATION_ENABLED="false"
